# ==============================================================================
# .gitignore — OptiExam Assessment Platform
# Stack: Python 3.12+ / Django 5.x / Windows / SQLite + PostgreSQL
# ==============================================================================

# ==============================================================================
# 1. ENVIRONMENT & SECRETS (CRITICAL — Never commit these!)
# ==============================================================================
.env
.env.local
.env.*.local
.env.production
.env.staging
production.env
*.env
!.env.example
*.secret
secrets.json

# ==============================================================================
# 2. PYTHON RUNTIME
# ==============================================================================
# Bytecode cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Python egg / distribution
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Virtual environments (project-local envs)
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/
# Note: C:\venv\envoptiexam is at the system level (not in project), no need to gitignore

# pip / setuptools
pip-log.txt
pip-delete-this-directory.txt

# ==============================================================================
# 3. DJANGO SPECIFIC
# ==============================================================================
# SQLite database(s)
*.sqlite3
db.sqlite3
db.sqlite3-journal

# Collected static files (generated by collectstatic)
staticfiles/
static_collected/

# User-uploaded media files
media/

# Django migration conflicts (keep migrations, ignore pyc only)
# migrations/  ← DO NOT ignore migrations — they must be committed!

# Django cache framework file-based cache
.cache/
django_cache/

# Django test output
test-results/

# ==============================================================================
# 4. LOGS & RUNTIME DATA
# ==============================================================================
logs/
*.log
*.log.*
log/
celerybeat-schedule
celerybeat.pid

# ==============================================================================
# 5. TESTING & COVERAGE
# ==============================================================================
# pytest
.pytest_cache/
.pytest_tmp/
pytest.ini.local

# Coverage reports
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage/

# Test result files
*.xml
test-output/
junit.xml

# ==============================================================================
# 6. TYPE CHECKING & LINTING
# ==============================================================================
# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ruff
.ruff_cache/

# ==============================================================================
# 7. WINDOWS OPERATING SYSTEM
# ==============================================================================
# Windows thumbnail cache
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Windows Recycle Bin
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

# Windows system files
desktop.ini
Desktop.ini

# Windows temp files
*.tmp
*.temp
~$*

# ==============================================================================
# 8. IDE & EDITORS
# ==============================================================================
# Visual Studio Code
.vscode/
*.code-workspace
.history/

# PyCharm / IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
.idea_modules/

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist
Session.vim
.vim/

# Emacs
*#
.\#*
.emacs.desktop
.emacs.desktop.lock

# Notepad++
nppBackup/

# ==============================================================================
# 9. BUILD & PACKAGE ARTIFACTS
# ==============================================================================
# Wheel builds
*.whl

# Installer logs
*.spec

# PyInstaller
dist/
build/

# ==============================================================================
# 10. DOCUMENTATION BUILD OUTPUT
# ==============================================================================
# Sphinx
docs/_build/
docs/build/
site/

# ==============================================================================
# 11. JUPYTER NOTEBOOKS (if used for analytics)
# ==============================================================================
.ipynb_checkpoints/
*.ipynb

# ==============================================================================
# 12. OPTIEXAM-SPECIFIC GENERATED FILES
# ==============================================================================
# Offline static bundle outputs (generated, not committed)
staticfiles/
static_bundle/

# Tenant-specific exports & reports generated at runtime
exports/
reports/

# Temporary CSV roster import working files
roster_imports/

# Admin-generated PDF scorecards
scorecards/

# Backup dumps
*.dump
*.sql.gz
backup_*.sql

# ==============================================================================
# 13. DOCKER (if applicable in future)
# ==============================================================================
.dockerenv
docker-compose.override.yml

# ==============================================================================
# 14. MISCELLANEOUS
# ==============================================================================
# macOS (if cross-platform team)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Node modules (if any frontend tooling is added)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Temporary files
*.bak
*.orig
*.rej
