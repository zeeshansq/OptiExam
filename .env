# ==============================================================================
# OPTIEXAM ACTIVE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Target: Local Development / Offline Lab
# Python Environment: C:\venv\envoptiexam\Scripts\python.exe
# ==============================================================================

DEBUG=True
SECRET_KEY=optiexam-dev-secret-key-3.12-django5-local-testing-suite-9921
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=optiexam.settings.local
OPTIEXAM_VERSION=1.0.0

# SQLite Database (default for local dev)
DB_ENGINE=sqlite
DATABASE_URL=sqlite:///db.sqlite3

# Multi-Tenancy
TENANT_COOKIE_NAME=opti_tenant
ROOT_DOMAIN=optiexam.local
DEFAULT_TENANT_SLUG=default

# Static & Media Files
STATIC_URL=/static/
STATIC_ROOT=staticfiles/
MEDIA_URL=/media/
MEDIA_ROOT=media/
OFFLINE_MODE_ENABLED=True

# Anti-Cheating & Proctoring
PROCTORING_HEARTBEAT_INTERVAL_SECONDS=15
PROCTORING_MAX_DISCONNECTED_SECONDS=60
PROCTORING_DEFAULT_MAX_TAB_VIOLATIONS=3
EXAM_RESUME_AES_SECRET=8fa3910c2ef34d85882191b2c4e5f6a7b8c9d0e1f2a3

# Email (console for local dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
DEFAULT_FROM_EMAIL=noreply@optiexam.local

# Cache (in-memory for local dev)
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/optiexam.log

# Security (relaxed for local dev)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
