# ==============================================================================
# OPTIEXAM ACTIVE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Target Virtual Environment: C:\venv\envoptiexam\Scripts\python.exe

DEBUG=True
SECRET_KEY=optiexam-dev-secret-key-3.12-django5-local-testing-suite-9921
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=optiexam.settings.local

# Default SQLite Database Engine
DB_ENGINE=sqlite
DATABASE_URL=sqlite:///db.sqlite3

# Multi-Tenancy & Domain Routing
TENANT_COOKIE_NAME=opti_tenant
ROOT_DOMAIN=optiexam.local
DEFAULT_TENANT_SLUG=default

# Offline Assets & Static Files
STATIC_URL=/static/
MEDIA_URL=/media/
OFFLINE_MODE_ENABLED=True

# Anti-Cheating & Proctoring Engine
PROCTORING_HEARTBEAT_INTERVAL_SECONDS=15
PROCTORING_MAX_DISCONNECTED_SECONDS=60
PROCTORING_DEFAULT_MAX_TAB_VIOLATIONS=3
EXAM_RESUME_AES_SECRET=8fa3910c2ef34d85882191b2c4e5f6a7

CACHE_BACKEND=locmem
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
