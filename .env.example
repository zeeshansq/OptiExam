# ==============================================================================
# OPTIEXAM ENVIRONMENT CONFIGURATION (EXAMPLE TEMPLATE)
# ==============================================================================
# Copy this file to .env and fill in all required values.
# Target Virtual Environment: C:\venv\envoptiexam\Scripts\python.exe
#
# IMPORTANT: Never commit the actual .env file to version control.
#            This .env.example IS committed as a reference template.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=optiexam-insecure-development-key-change-this-in-production-!@#$987654321
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*.optiexam.local
DJANGO_SETTINGS_MODULE=optiexam.settings.local

# Application version (shown in system_settings_context)
OPTIEXAM_VERSION=1.0.0

# ------------------------------------------------------------------------------
# 2. DUAL-DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# ── Option A: SQLite (Default for offline lab / local development / air-gapped)
DB_ENGINE=sqlite
DATABASE_URL=sqlite:///db.sqlite3

# ── Option B: PostgreSQL (Uncomment for multi-tenant production SaaS)
# DB_ENGINE=postgres
# DATABASE_URL=postgres://opti_user:StrongPassword2026!@127.0.0.1:5432/optiexam_db
# DB_CONN_MAX_AGE=600
# DB_POOL_MAX_CONNECTIONS=20

# ------------------------------------------------------------------------------
# 3. MULTI-TENANCY & DOMAIN ROUTING
# ------------------------------------------------------------------------------
TENANT_COOKIE_NAME=opti_tenant
ROOT_DOMAIN=optiexam.local
DEFAULT_TENANT_SLUG=demo-institution

# ------------------------------------------------------------------------------
# 4. STATIC FILES & MEDIA (Offline-Ready)
# ------------------------------------------------------------------------------
STATIC_URL=/static/
STATIC_ROOT=staticfiles/
MEDIA_URL=/media/
MEDIA_ROOT=media/
OFFLINE_MODE_ENABLED=True

# ------------------------------------------------------------------------------
# 5. ANTI-CHEATING & PROCTORING ENGINE
# ------------------------------------------------------------------------------
PROCTORING_HEARTBEAT_INTERVAL_SECONDS=15
PROCTORING_MAX_DISCONNECTED_SECONDS=60
PROCTORING_DEFAULT_MAX_TAB_VIOLATIONS=3

# AES secret for encrypting offline candidate attempt tokens in localStorage
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
EXAM_RESUME_AES_SECRET=change-this-to-a-64-char-hex-string-generated-securely

# ------------------------------------------------------------------------------
# 6. EMAIL CONFIGURATION
# ------------------------------------------------------------------------------
# ── Development: output to console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@optiexam.local

# ── Production: uncomment and configure
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yourmailprovider.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=OptiExam <noreply@yourdomain.com>

# ------------------------------------------------------------------------------
# 7. CACHE CONFIGURATION
# ------------------------------------------------------------------------------
# ── Development: in-memory local cache
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# ── Production: Redis (recommended for multi-instance deployments)
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_URL=redis://127.0.0.1:6379/1
# CACHE_KEY_PREFIX=optiexam

# ------------------------------------------------------------------------------
# 8. LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/optiexam.log

# ------------------------------------------------------------------------------
# 9. SECURITY HEADERS (set to True in production only)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY

# ------------------------------------------------------------------------------
# 10. OPTIONAL INTEGRATIONS
# ------------------------------------------------------------------------------
# Sentry error tracking (optional)
# SENTRY_DSN=https://your-dsn@sentry.io/your-project-id
